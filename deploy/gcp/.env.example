# Only used for the first setup: scripts/gen-secrets.sh creates .env on the VM and fills MQTT_PASSWORD.
# After the values are moved to Secret Manager (README, step 5), scripts/deploy.sh rebuilds .env on every deploy.
MQTT_PASSWORD=
# From @BotFather. If the old token was ever exposed, revoke it there (/revoke) and use the new one.
TELEGRAM_BOT_TOKEN=
# Chat IDs of the administrators (comma-separated). Admins approve and remove other users inside the bot.
# Send /start to a bot that has no admin yet and it shows your chat ID.
TELEGRAM_ADMIN_CHAT_IDS=
